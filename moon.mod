name = "moonbitstack/moondate"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moondate"

license = "Apache-2.0"

keywords = [ "date", "time", "duration", "cron", "moonbit" ]

description = "moondate — dates, times, instants, durations and cron expressions for MoonBit. The proleptic Gregorian calendar with the arithmetic that goes with it; RFC 3339, the four shapes TOML names, HTTP's IMF-fixdate and ASN.1's two time forms, read and written; and a cron package that answers when an expression fires next."

preferred_target = "wasm-gc"
