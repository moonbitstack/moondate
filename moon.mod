name = "moonbitstack/moondate"

version = "0.1.5"

readme = "README.md"

repository = "https://github.com/moonbitstack/moondate"

license = "Apache-2.0"

keywords = [
  "date",
  "time",
  "datetime",
  "duration",
  "calendar",
  "utc-offset",
  "timezone",
  "time-zone",
  "tz",
  "tzdata",
  "tzif",
  "zoneinfo",
  "iana",
  "daylight-saving",
  "dst",
  "local-time",
  "fold",
  "posix-tz",
  "rfc9636",
  "cron",
  "crontab",
  "iso8601",
  "rfc3339",
  "http-date",
  "asn1",
  "strftime",
  "strptime",
  "ldml",
  "parsing",
  "formatting",
  "moonbit",
]

description = "Dates, times, durations and cron expressions for MoonBit."

source = "src"

import {
  "moonbitlang/x@0.5.7",
}
