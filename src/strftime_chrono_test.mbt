// Generated by scripts/chrono_vectors from Rust chrono's strftime.
// The expected strings are chrono's own output; do not edit by hand.

///|
fn vc_zoned(
  y : Int32,
  m : Int32,
  d : Int32,
  hh : Int32,
  mi : Int32,
  sec : Int32,
  u : Int32,
  off : Int32,
) -> @moondate.Moment raise @moondate.Refused {
  @moondate.Moment::Zoned(
    date=@moondate.Date::new(y, m, d),
    time=@moondate.Time::new(hh, mi, second=sec, nano=u),
    zone=@moondate.Offset(off),
  )
}

///|
test "chrono vectors #0" {
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%k"),
    "14",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%l"),
    " 2",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%3f"),
    "123",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%N"),
    "123456789",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%.6f"),
    ".123456",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%:z"),
    "+08:00",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%::z"),
    "+08:00:00",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%:::z"),
    "+08",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 480).strftime("%+"),
    "2026-09-22T14:30:05.123456789+08:00",
  )
}

///|
test "chrono vectors #1" {
  assert_eq(vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%k"), "14")
  assert_eq(vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%l"), " 2")
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%3f"),
    "123",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%N"),
    "123456789",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%.6f"),
    ".123456",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%:z"),
    "+00:00",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%::z"),
    "+00:00:00",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%:::z"),
    "+00",
  )
  assert_eq(
    vc_zoned(2026, 9, 22, 14, 30, 5, 123456789, 0).strftime("%+"),
    "2026-09-22T14:30:05.123456789+00:00",
  )
}

///|
test "chrono vectors #2" {
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%k"), " 3")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%l"), " 3")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%3f"), "000")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%N"), "000000000")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%.6f"), ".000000")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%:z"), "+00:00")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%::z"), "+00:00:00")
  assert_eq(vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%:::z"), "+00")
  assert_eq(
    vc_zoned(1999, 1, 5, 3, 4, 7, 0, 0).strftime("%+"),
    "1999-01-05T03:04:07+00:00",
  )
}

///|
test "chrono vectors #3" {
  assert_eq(vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%k"), "23")
  assert_eq(vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%l"), "11")
  assert_eq(vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%3f"), "000")
  assert_eq(
    vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%N"),
    "000000000",
  )
  assert_eq(
    vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%.6f"),
    ".000000",
  )
  assert_eq(
    vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%:z"),
    "-05:30",
  )
  assert_eq(
    vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%::z"),
    "-05:30:00",
  )
  assert_eq(
    vc_zoned(2000, 2, 29, 23, 59, 59, 0, -330).strftime("%+"),
    "2000-02-29T23:59:59-05:30",
  )
}

