// Generated by scripts/gen_ecma_vectors.js from Node's Date.
// The expected strings are Node's own output; do not edit by hand.

///|
fn e_utc(
  y : Int32,
  m : Int32,
  d : Int32,
  hh : Int32,
  mi : Int32,
  sec : Int32,
  u : Int32,
) -> @moondate.Moment raise @moondate.Refused {
  @moondate.Moment::Zoned(
    date=@moondate.Date::new(y, m, d),
    time=@moondate.Time::new(hh, mi, second=sec, nano=u * 1_000_000),
    zone=@moondate.Utc,
  )
}

///|
test "ecma 0" {
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).to_iso_string(),
    "2026-09-22T14:30:05.000Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).to_utc_string(),
    "Tue, 22 Sep 2026 14:30:05 GMT",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=3),
    "2026-09-22T14:30:05.000Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=0),
    "2026-09-22T14:30:05Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=-1),
    "2026-09-22T14:30:05Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=3, offset=false),
    "2026-09-22T14:30:05.000",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=1),
    "2026-09-22T14:30:05.0Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=2),
    "2026-09-22T14:30:05.00Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=6),
    "2026-09-22T14:30:05.000000Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 0).isoformat(fraction=9),
    "2026-09-22T14:30:05.000000000Z",
  )
}

///|
test "ecma 1" {
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).to_iso_string(),
    "2026-09-22T14:30:05.123Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).to_utc_string(),
    "Tue, 22 Sep 2026 14:30:05 GMT",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=3),
    "2026-09-22T14:30:05.123Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=0),
    "2026-09-22T14:30:05Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=-1),
    "2026-09-22T14:30:05.123Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=3, offset=false),
    "2026-09-22T14:30:05.123",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=1),
    "2026-09-22T14:30:05.1Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=2),
    "2026-09-22T14:30:05.12Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=6),
    "2026-09-22T14:30:05.123000Z",
  )
  assert_eq(
    e_utc(2026, 9, 22, 14, 30, 5, 123).isoformat(fraction=9),
    "2026-09-22T14:30:05.123000000Z",
  )
}

