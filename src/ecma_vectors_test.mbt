test "ecma 2" {
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).to_iso_string(),
    "1999-01-05T03:04:07.000Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).to_utc_string(),
    "Tue, 05 Jan 1999 03:04:07 GMT",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=3),
    "1999-01-05T03:04:07.000Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=0),
    "1999-01-05T03:04:07Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=-1),
    "1999-01-05T03:04:07Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=3, offset=false),
    "1999-01-05T03:04:07.000",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=1),
    "1999-01-05T03:04:07.0Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=2),
    "1999-01-05T03:04:07.00Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=6),
    "1999-01-05T03:04:07.000000Z",
  )
  assert_eq(
    e_utc(1999, 1, 5, 3, 4, 7, 0).isoformat(fraction=9),
    "1999-01-05T03:04:07.000000000Z",
  )
}

