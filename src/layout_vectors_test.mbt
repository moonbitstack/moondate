// Generated by scripts/go_vectors from Go's time.Format.
// The expected strings are Go's own output; do not edit by hand.

///|
fn g_zoned(
  y : Int32,
  m : Int32,
  d : Int32,
  hh : Int32,
  mi : Int32,
  sec : Int32,
  u : Int32,
  off : Int32,
) -> @moondate.Moment raise @moondate.Refused {
  @moondate.Moment::Zoned(
    date=@moondate.Date::new(y, m, d),
    time=@moondate.Time::new(hh, mi, second=sec, nano=u),
    zone=@moondate.Offset(off),
  )
}

