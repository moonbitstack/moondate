// The test262 cases whose text names a zone by a place rather than by an offset,
// replayed through `@tzdata.parse`, which is the entry point that has the
// database. The tables are generated by scripts/temporal_vectors/build.py.

///|
/// A moment's instant, split into whole seconds and the nanoseconds after them.
fn instant_parts(moment : @moondate.Moment) -> (Int64, Int64)? {
  match moment.epoch() {
    Some(seconds) => Some((seconds, moment.time().nanos() % 1_000_000_000L))
    None => None
  }
}

///|
test "test262: a place names an instant" {
  let wrong : Array[String] = []
  for row in places {
    let (text, seconds, nano, zone) = row
    let parsed = Some(parse(text)) catch { _ => None }
    match parsed {
      None => wrong.push("refused, want an instant: " + text)
      Some(moment) =>
        match instant_parts(moment) {
          None => wrong.push("no instant: " + text)
          Some((got_seconds, got_nano)) =>
            if got_seconds != seconds || got_nano != nano {
              wrong.push(text + ": read the wrong instant")
            }
        }
    }
    if zone != "" {
      let named = match parsed {
        Some(moment) =>
          match moment.zone() {
            Some(z) => z.name()
            None => ""
          }
        None => ""
      }
      if named != zone {
        wrong.push(text + ": filed under " + named + ", want " + zone)
      }
    }
  }
  assert_eq(wrong, [])
}

///|
test "test262: a place names a date" {
  let wrong : Array[String] = []
  for row in place_dates {
    let (text, year, month, day) = row
    let parsed = Some(parse(text)) catch { _ => None }
    match parsed {
      None => wrong.push("refused, want a date: " + text)
      Some(moment) =>
        match moment.date() {
          None => wrong.push("no date: " + text)
          Some(date) =>
            if date.year != year || date.month != month || date.day != day {
              wrong.push(text + ": read the wrong day")
            }
        }
    }
  }
  assert_eq(wrong, [])
}

///|
test "test262: a place is refused" {
  let wrong : Array[String] = []
  for row in place_refusals {
    let (text, want) = row
    let parsed = Some(parse(text)) catch { _ => None }
    if parsed is Some(moment) {
      wrong.push(text + ": read as " + moment.to_string() + ", want " + want)
    }
  }
  assert_eq(wrong, [])
}

///|
test "a place is resolved by the database" {
  // The hour New York reads twice: `Compatible` takes the first, `Later` the
  // second, and both are the same wall clock an hour apart.
  let compatible = parse("2026-11-01T01:30:00[America/New_York]")
  assert_eq(compatible.strftime("%Y-%m-%d %H:%M %Z"), "2026-11-01 01:30 EDT")
  let later = parse("2026-11-01T01:30:00[America/New_York]", fold=@zone.Later)
  assert_eq(later.strftime("%Y-%m-%d %H:%M %Z"), "2026-11-01 01:30 EST")
  // An offset beside the place is kept as written, and a calendar beside it is
  // still read by the root package.
  assert_eq(
    parse("2026-11-01T01:30:00-04:00[America/New_York]").to_string(),
    "2026-11-01T01:30:00-04:00",
  )
  assert_eq(
    parse("1970-01-01T00:00[UTC][u-ca=iso8601]").to_string(),
    "1970-01-01T00:00:00+00:00",
  )
  // A text with no bracket at all is the root reader's, and so is an offset.
  assert_eq(parse("2026-09-22T14:30:00Z").to_string(), "2026-09-22T14:30:00Z")
}
