    zone: "UTC",
    epoch: 1000000000L,
    nano: 0,
    at: 1800000000000L,
    want_zone: "UTC",
    want_epoch: 999995400L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/withPlainTime/basic.js",
    zone: "-08:00",
    epoch: 1449487470L,
    nano: 3500,
    at: 36000000000000L,
    want_zone: "-08:00",
    want_epoch: 1449511200L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/withPlainTime/basic.js",
    zone: "-08:00",
    epoch: 1449487470L,
    nano: 3500,
    at: 40920000000000L,
    want_zone: "-08:00",
    want_epoch: 1449516120L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/withPlainTime/basic.js",
    zone: "-08:00",
    epoch: 1449487470L,
    nano: 3500,
    at: 45240000000000L,
    want_zone: "-08:00",
    want_epoch: 1449520440L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/withPlainTime/plaintime-propertybag-no-time-units.js",
    zone: "UTC",
    epoch: 1000000000L,
    nano: 0,
    at: 1800000000000L,
    want_zone: "UTC",
    want_epoch: 999995400L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/withPlainTime/subclassing-ignored.js",
    zone: "UTC",
    epoch: 0L,
    nano: 10,
    at: 20601123456789L,
    want_zone: "UTC",
    want_epoch: 20601L,
    want_nano: 123456789,
  })
  out.push({
    case: "prototype/withPlainTime/time-undefined.js",
    zone: "UTC",
    epoch: 957270896L,
    nano: 987654321,
    at: 0L,
    want_zone: "UTC",
    want_epoch: 957225600L,
    want_nano: 0,
  })
}

///|
fn timesets_all() -> Array[TimeSetNanos] {
  let out : Array[TimeSetNanos] = []
  timesets_part_1(out)
  out
}

///|
fn zones_part_1(out : Array[ZoneCase]) -> Unit {
  out.push({
    case: "compare/disregard-time-zone-ids-if-exact-times-are-equal.js",
    zone: "+01:00",
    epoch: 217175010L,
    nano: 123456789,
    into_zone: "+05:30",
    want_zone: "+05:30",
    want_epoch: 217175010L,
    want_nano: 123456789,
  })
  out.push({
    case: "prototype/withTimeZone/preserves-instant.js",
    zone: "+01:00",
    epoch: 1574087010L,
    nano: 123456789,
    into_zone: "-08:00",
    want_zone: "-08:00",
    want_epoch: 1574087010L,
    want_nano: 123456789,
  })
  out.push({
    case: "prototype/withTimeZone/subclassing-ignored.js",
    zone: "UTC",
    epoch: 0L,
    nano: 10,
    into_zone: "+01:00",
    want_zone: "+01:00",
    want_epoch: 0L,
    want_nano: 10,
  })
  out.push({
    case: "prototype/withTimeZone/timezone-string.js",
    zone: "UTC",
    epoch: 0L,
    nano: 0,
    into_zone: "+01:30",
    want_zone: "+01:30",
    want_epoch: 0L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/withTimeZone/timezone-string.js",
    zone: "UTC",
    epoch: 0L,
    nano: 0,
    into_zone: "UTC",
    want_zone: "UTC",
    want_epoch: 0L,
    want_nano: 0,
  })
}

///|
fn zones_all() -> Array[ZoneCase] {
  let out : Array[ZoneCase] = []
  zones_part_1(out)
  out
}
