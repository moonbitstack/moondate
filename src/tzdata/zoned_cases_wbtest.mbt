  let out : Array[EqualCase] = []
  equals_part_1(out)
  out
}

///|
fn compares_part_1(out : Array[CompareCase]) -> Unit {
  out.push({
    case: "compare/basic.js",
    left_zone: "+01:00",
    left_epoch: 1572342398L,
    left_nano: 271986102,
    right_zone: "+01:00",
    right_epoch: 217175010L,
    right_nano: 123456789,
    want: 1,
  })
  out.push({
    case: "compare/basic.js",
    left_zone: "+01:00",
    left_epoch: 217175010L,
    left_nano: 123456789,
    right_zone: "+01:00",
    right_epoch: 1572342398L,
    right_nano: 271986102,
    want: -1,
  })
  out.push({
    case: "compare/basic.js",
    left_zone: "+01:00",
    left_epoch: 217175010L,
    left_nano: 123456789,
    right_zone: "+01:00",
    right_epoch: 217175010L,
    right_nano: 123456789,
    want: 0,
  })
  out.push({
    case: "compare/compares-exact-time-not-clock-time.js",
    left_zone: "-08:00",
    left_epoch: 946711800L,
    left_nano: 0,
    right_zone: "-04:00",
    right_epoch: 946704600L,
    right_nano: 0,
    want: 1,
  })
  out.push({
    case: "compare/disregard-time-zone-ids-if-exact-times-are-equal.js",
    left_zone: "+01:00",
    left_epoch: 217175010L,
    left_nano: 123456789,
    right_zone: "+05:30",
    right_epoch: 217175010L,
    right_nano: 123456789,
    want: 0,
  })
}

///|
fn compares_all() -> Array[CompareCase] {
  let out : Array[CompareCase] = []
  compares_part_1(out)
  out
}

///|
fn day_part_1(out : Array[DayCase]) -> Unit {
  out.push({
    case: "prototype/startOfDay/basic.js",
    zone: "UTC",
    epoch: 864007272L,
    nano: 123456789,
    want_zone: "UTC",
    want_epoch: 864000000L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/startOfDay/subclassing-ignored.js",
    zone: "UTC",
    epoch: 88000L,
    nano: 123456789,
    want_zone: "UTC",
    want_epoch: 86400L,
    want_nano: 0,
  })
}

///|
fn day_all() -> Array[DayCase] {
  let out : Array[DayCase] = []
  day_part_1(out)
  out
}

///|
fn transitions_part_1(out : Array[TransitionCase]) -> Unit {
  out.push({
    case: "prototype/getTimeZoneTransition/offset-timezone-no-transitions.js",
    zone: "-10:00",
    epoch: 0L,
    nano: 0,
    next: false,
    found: false,
    want_zone: "",
    want_epoch: 0L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/getTimeZoneTransition/offset-timezone-no-transitions.js",
    zone: "-10:00",
    epoch: 0L,
    nano: 0,
    next: true,
    found: false,
    want_zone: "",
    want_epoch: 0L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/getTimeZoneTransition/utc-no-transitions.js",
    zone: "UTC",
    epoch: 0L,
    nano: 0,
    next: false,
    found: false,
    want_zone: "",
    want_epoch: 0L,
    want_nano: 0,
  })
  out.push({
    case: "prototype/getTimeZoneTransition/utc-no-transitions.js",
    zone: "UTC",
    epoch: 0L,
    nano: 0,
    next: true,
    found: false,
    want_zone: "",
    want_epoch: 0L,
    want_nano: 0,
  })
}

///|
fn transitions_all() -> Array[TransitionCase] {
  let out : Array[TransitionCase] = []
  transitions_part_1(out)
  out
}

