///|
fn diffs_all() -> Array[DiffCase] {
  let out : Array[DiffCase] = []
  diffs_part_1(out)
  diffs_part_2(out)
  diffs_part_3(out)
  diffs_part_4(out)
  diffs_part_5(out)
  diffs_part_6(out)
  diffs_part_7(out)
  diffs_part_8(out)
  diffs_part_9(out)
  diffs_part_10(out)
  diffs_part_11(out)
  out
}

