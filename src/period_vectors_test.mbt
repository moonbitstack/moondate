///|
fn comparecase_all() -> Array[CompareCase] {
  let out : Array[CompareCase] = []
  comparecase_part_1(out)
  comparecase_part_2(out)
  comparecase_part_3(out)
  comparecase_part_4(out)
  comparecase_part_5(out)
  out
}

///|
struct ParseCase {
  text : String
  want : (Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64)
}

///|
fn parsecase_part_1(out : Array[ParseCase]) -> Unit {
  out.push({ text: "P1Y2M3DT4H5M6.007S", want: (1, 2, 0, 3, 4, 5, 6, 7000000), })
  out.push({ text: "P1W", want: (0, 0, 1, 0, 0, 0, 0, 0), })
  out.push({ text: "-P1D", want: (0, 0, 0, -1, 0, 0, 0, 0), })
  out.push({ text: "PT0S", want: (0, 0, 0, 0, 0, 0, 0, 0), })
  out.push({ text: "P0D", want: (0, 0, 0, 0, 0, 0, 0, 0), })
  out.push({ text: "-PT0.5S", want: (0, 0, 0, 0, 0, 0, 0, -500000000), })
  out.push({ text: "PT1.5H", want: (0, 0, 0, 0, 1, 30, 0, 0), })
  out.push({ text: "P1Y", want: (1, 0, 0, 0, 0, 0, 0, 0), })
  out.push({ text: "P2M", want: (0, 2, 0, 0, 0, 0, 0, 0), })
  out.push({ text: "PT36H", want: (0, 0, 0, 0, 36, 0, 0, 0), })
  out.push({ text: "P1DT12H", want: (0, 0, 0, 1, 12, 0, 0, 0), })
  out.push({ text: "-P1Y2M", want: (-1, -2, 0, 0, 0, 0, 0, 0), })
  out.push({ text: "PT0.000000001S", want: (0, 0, 0, 0, 0, 0, 0, 1), })
  out.push({
    text: "P1Y2M3W4DT5H6M7.00800901S",
    want: (1, 2, 3, 4, 5, 6, 7, 8009010),
  })
}

///|
fn parsecase_all() -> Array[ParseCase] {
  let out : Array[ParseCase] = []
  parsecase_part_1(out)
  out
}

///|
struct LimitCase {
  length : (Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64)
  taken : Bool
}

///|
fn limitcase_part_1(out : Array[LimitCase]) -> Unit {
  out.push({ length: (4294967295L, 0, 0, 0, 0, 0, 0, 0), taken: true, })
  out.push({ length: (4294967296L, 0, 0, 0, 0, 0, 0, 0), taken: false, })
  out.push({ length: (-4294967295L, 0, 0, 0, 0, 0, 0, 0), taken: true, })
  out.push({ length: (-4294967296L, 0, 0, 0, 0, 0, 0, 0), taken: false, })
  out.push({ length: (0, 0, 0, 0, 0, 0, 4294967295L, 0), taken: true, })
  out.push({ length: (0, 0, 0, 0, 0, 0, 4294967296L, 0), taken: true, })
  out.push({ length: (0, 0, 0, 0, 0, 0, 0, 4294967295L), taken: true, })
  out.push({ length: (0, 0, 0, 0, 0, 0, 0, 4294967296L), taken: true, })
  out.push({ length: (0, 0, 0, 0, 4294967295L, 0, 0, 0), taken: true, })
  out.push({ length: (0, 0, 0, 4294967296L, 0, 0, 0, 0), taken: true, })
  out.push({ length: (0, 0, 0, 0, 0, 0, 0, 0), taken: true, })
}

///|
fn limitcase_all() -> Array[LimitCase] {
  let out : Array[LimitCase] = []
  limitcase_part_1(out)
  out
}
