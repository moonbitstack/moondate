test "python vectors #5 (v_plain(1999, 1, 5, 0, 0, 0, 0))" {
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Y"), "1999")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%C"), "19")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%y"), "99")
