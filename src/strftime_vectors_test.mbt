  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%V"), "39")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%u"), "2")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%w"), "2")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%a"), "Tue")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%A"), "Tuesday")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%H"), "14")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%I"), "02")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%M"), "30")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%S"), "05")
