// Generated by scripts/gen_strftime_vectors.py from CPython's strftime.
// The expected strings are CPython's own output; do not edit by hand.

///|
fn v_zoned(
  y : Int32,
  m : Int32,
  d : Int32,
  hh : Int32,
  mi : Int32,
  sec : Int32,
  u : Int32,
  off : Int32,
) -> @moondate.Moment raise @moondate.Refused {
  @moondate.Moment::Zoned(
    date=@moondate.Date::new(y, m, d),
    time=@moondate.Time::new(hh, mi, second=sec, nano=u * 1000),
    zone=@moondate.Offset(off),
  )
}

///|
fn v_plain(
  y : Int32,
  m : Int32,
  d : Int32,
  hh : Int32,
  mi : Int32,
  sec : Int32,
  u : Int32,
) -> @moondate.Moment raise @moondate.Refused {
  @moondate.Moment::Plain(
    date=@moondate.Date::new(y, m, d),
    time=@moondate.Time::new(hh, mi, second=sec, nano=u * 1000),
  )
}

