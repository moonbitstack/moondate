  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%Z"), "")
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%c"),
    "Tue Sep 22 14:30:05 2026",
  )
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%x"), "09/22/26")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%X"), "14:30:05")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%D"), "09/22/26")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%R"), "14:30")
