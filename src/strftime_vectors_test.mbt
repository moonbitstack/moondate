  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%t"), "\t")
  assert_eq(v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%%"), "%")
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%Y-%m-%d %H:%M:%S"),
    "2026-09-22 14:30:05",
  )
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%G-W%V-%u"),
    "2026-W39-2",
  )
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%Y-%m-%dT%H:%M:%S%z"),
    "2026-09-22T14:30:05",
  )
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%Y-%m-%d %j"),
    "2026-09-22 265",
  )
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%Y %U %w"),
    "2026 38 2",
  )
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%Y %W %w"),
    "2026 38 2",
  )
  assert_eq(
    v_plain(2026, 9, 22, 14, 30, 5, 123456).strftime("%I:%M:%S %p"),
    "02:30:05 PM",
  )
}

