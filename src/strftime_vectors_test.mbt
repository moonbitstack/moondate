  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%b"), "Jan")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%h"), "Jan")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%d"), "05")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%e"), " 5")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%j"), "005")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%U"), "01")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%W"), "01")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%V"), "01")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%u"), "2")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%w"), "2")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%a"), "Tue")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%A"), "Tuesday")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%H"), "00")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%I"), "12")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%M"), "00")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%S"), "00")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%p"), "AM")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%f"), "000000")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%z"), "")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Z"), "")
  assert_eq(
    v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%c"),
    "Tue Jan  5 00:00:00 1999",
  )
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%x"), "01/05/99")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%X"), "00:00:00")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%D"), "01/05/99")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%R"), "00:00")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%r"), "12:00:00 AM")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%n"), "\n")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%t"), "\t")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%%"), "%")
  assert_eq(
    v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Y-%m-%d %H:%M:%S"),
    "1999-01-05 00:00:00",
  )
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%G-W%V-%u"), "1999-W01-2")
  assert_eq(
    v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Y-%m-%dT%H:%M:%S%z"),
    "1999-01-05T00:00:00",
  )
  assert_eq(
    v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Y-%m-%d %j"),
    "1999-01-05 005",
  )
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Y %U %w"), "1999 01 2")
  assert_eq(v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%Y %W %w"), "1999 01 2")
  assert_eq(
    v_plain(1999, 1, 5, 0, 0, 0, 0).strftime("%I:%M:%S %p"),
    "12:00:00 AM",
  )
}

